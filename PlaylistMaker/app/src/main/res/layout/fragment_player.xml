<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/playerFragment"
    style="@style/OtherScreensBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".player.ui.fragment.PlayerFragment">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <View
                android:id="@+id/header_panel"
                android:layout_width="match_parent"
                android:layout_height="@dimen/panel_header_height"
                android:visibility="invisible"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageButton
                android:id="@+id/back_button"
                style="@style/HeaderPanelElementsColor"
                android:layout_width="@dimen/back_butt_layout_width"
                android:layout_height="@dimen/back_butt_layout_width"
                android:layout_marginStart="@dimen/margin_4dp"
                android:layout_marginTop="@dimen/margin_4dp"
                app:layout_constraintStart_toStartOf="@id/header_panel"
                app:layout_constraintTop_toTopOf="@id/header_panel"
                app:srcCompat="@drawable/ic_arrow_back_24" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/left_guideline"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="vertical"
                app:layout_constraintGuide_begin="@dimen/ic_size_24" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/right_guideline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_end="@dimen/ic_size_24" />

            <ImageView
                android:id="@+id/track_cover"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_placeholder_312"
                app:layout_constraintEnd_toStartOf="@id/right_guideline"
                app:layout_constraintStart_toEndOf="@id/left_guideline"
                app:layout_constraintTop_toBottomOf="@id/header_panel" />

            <TextView
                android:id="@+id/track_name"
                style="@style/PlayerTrackNameAndArtistName"
                app:layout_constraintEnd_toStartOf="@id/right_guideline"
                app:layout_constraintStart_toEndOf="@id/left_guideline"
                app:layout_constraintTop_toBottomOf="@id/track_cover" />

            <TextView
                android:id="@+id/artist_name"
                style="@style/PlayerTrackNameAndArtistName"
                android:layout_marginTop="12dp"
                android:textSize="@dimen/text_size_14"
                app:layout_constraintEnd_toStartOf="@id/right_guideline"
                app:layout_constraintStart_toEndOf="@id/left_guideline"
                app:layout_constraintTop_toBottomOf="@id/track_name" />

            <ImageButton
                android:id="@+id/play_stop_btn"
                style="@style/HeaderPanelElementsColor"
                android:layout_width="@dimen/ic_size_100"
                android:layout_height="@dimen/ic_size_100"
                android:layout_marginTop="@dimen/margin_30"
                android:background="@drawable/button_ripple_oval"
                android:src="@drawable/ic_play_btn_100"
                app:layout_constraintEnd_toStartOf="@id/right_guideline"
                app:layout_constraintStart_toEndOf="@id/left_guideline"
                app:layout_constraintTop_toBottomOf="@id/artist_name" />

            <ImageButton
                android:id="@+id/add_to_playlist"
                style="@style/AddToPlaylistAndAddToFavorite"
                android:background="@drawable/button_ripple_oval"
                android:src="@drawable/ic_add_to_playlist_51"
                app:layout_constraintStart_toEndOf="@id/left_guideline"
                app:layout_constraintTop_toTopOf="@id/play_stop_btn" />

            <ImageButton
                android:id="@+id/add_to_favorite"
                android:layout_width="@dimen/ic_size_51"
                android:layout_height="@dimen/ic_size_51"
                android:layout_marginTop="@dimen/ic_size_24"

                android:background="@drawable/button_ripple_oval"
                android:src="@drawable/ic_favorite_non_active_51"
                app:layout_constraintEnd_toStartOf="@id/right_guideline"
                app:layout_constraintTop_toTopOf="@id/play_stop_btn" />

            <TextView
                android:id="@+id/time_below_play_btn"
                style="@style/HeaderPanelElementsColor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_4dp"
                android:fontFamily="@font/ys_display_medium"
                android:textSize="@dimen/text_size_14"
                app:layout_constraintEnd_toStartOf="@id/right_guideline"
                app:layout_constraintStart_toEndOf="@id/left_guideline"
                app:layout_constraintTop_toBottomOf="@id/play_stop_btn" />

            <LinearLayout
                android:id="@+id/linlay_duration"
                android:layout_width="0dp"
                android:layout_height="@dimen/height_32"
                android:layout_marginTop="@dimen/margin_30"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/time_below_play_btn">

                <TextView
                    style="@style/TrackDescription"
                    android:layout_marginStart="@dimen/margin_16"
                    android:text="@string/duration"
                    android:textColor="@color/grey" />

                <TextView
                    android:id="@+id/track_time"
                    style="@style/TrackDescription"
                    android:layout_width="match_parent"
                    android:layout_marginEnd="@dimen/margin_16"
                    android:gravity="end" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/linlay_collection"
                android:layout_width="0dp"
                android:layout_height="@dimen/height_32"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/linlay_duration"
                app:layout_goneMarginTop="@dimen/margin_30">

                <TextView
                    style="@style/TrackDescription"
                    android:layout_marginStart="@dimen/margin_16"
                    android:text="@string/album"
                    android:textColor="@color/grey" />

                <TextView
                    android:id="@+id/collection_name"
                    style="@style/TrackDescription"
                    android:layout_width="match_parent"
                    android:layout_marginEnd="@dimen/margin_16"
                    android:gravity="end" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/linlay_releaseDate"
                android:layout_width="0dp"
                android:layout_height="@dimen/height_32"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/linlay_collection">

                <TextView
                    style="@style/TrackDescription"
                    android:layout_marginStart="@dimen/margin_16"
                    android:text="@string/year"
                    android:textColor="@color/grey" />

                <TextView
                    android:id="@+id/releaseDate"
                    style="@style/TrackDescription"
                    android:layout_width="match_parent"
                    android:layout_marginEnd="@dimen/margin_16"
                    android:gravity="end" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/linlay_genre"
                android:layout_width="0dp"
                android:layout_height="@dimen/height_32"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/linlay_releaseDate">

                <TextView
                    style="@style/TrackDescription"
                    android:layout_marginStart="@dimen/margin_16"
                    android:text="@string/genre"
                    android:textColor="@color/grey" />

                <TextView
                    android:id="@+id/track_genre"
                    style="@style/TrackDescription"
                    android:layout_width="match_parent"
                    android:layout_marginEnd="@dimen/margin_16"
                    android:gravity="end" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/linlay_country"
                android:layout_width="0dp"
                android:layout_height="@dimen/height_32"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/linlay_genre">

                <TextView
                    style="@style/TrackDescription"
                    android:layout_marginStart="@dimen/margin_16"
                    android:text="@string/country"
                    android:textColor="@color/grey" />

                <TextView
                    android:id="@+id/track_country"
                    style="@style/TrackDescription"
                    android:layout_width="match_parent"
                    android:layout_marginEnd="@dimen/margin_16"
                    android:gravity="end" />
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <View
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#991a1b22"
        android:visibility="gone" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/playlists_bottom_sheet"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bottom_sheet_bg"
        app:behavior_hideable="true"
        app:behavior_peekHeight="400dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <View
            android:id="@+id/handle"
            android:layout_width="50dp"
            android:layout_height="4dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/handle_bottom_sheet"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/text_add_to_playlist"/>

        <TextView
            android:id="@+id/text_add_to_playlist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_30"
            android:fontFamily="@font/ys_display_medium"
            android:text="@string/add_to_palylist"
            android:textColor="@color/bottom_nav_inactive"
            android:textSize="@dimen/text_size_19"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/handle"
            app:layout_constraintBottom_toTopOf="@id/newPlaylist"/>

        <Button
            android:id="@+id/newPlaylist"
            style="@style/UpdateButtonStyle"
            android:layout_marginTop="28dp"
            android:text="@string/new_playlist"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/text_add_to_playlist"
            app:layout_constraintBottom_toTopOf="@id/recyclerViewPlaylists"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewPlaylists"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="24dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/newPlaylist"
            app:layout_constraintBottom_toBottomOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
